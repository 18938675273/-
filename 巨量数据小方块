    <script>
      /*****       ***********/
      $("body").on("click", ".tr_point", function () {
        var dex = $(this).index(".tr_point");
        var from = parseInt($(this).parent().find(".td_from_1").val());
        var last = parseInt($(this).parent().find(".td_last_1").val());
        func_select([from, last]);
        $(".tr_point").parent().css("backgroundColor", "#fff");
        $(this).parent().css("backgroundColor", "#ddd");
      });
      $("body").on("click", ".btn_refresh", function () {
        var all_unit = $(".all_unit");
        var num = 0;
        $.each(all_unit, function () {
          num += parseInt($(this).text());
        });
        fun_rect([0], [num - 1]);
      });

      // window.onload = function () {
      //     var can = document.getElementById('myCanvas');
      //     var pro = can.innerHTML.substring(0, can.innerHTML.length - 1);
      //     var cxt = can.getContext('2d');
      // }
      var ccc = document.getElementById("myCanvas");
      var cxt = ccc.getContext("2d");
      var ccc_2 = document.getElementById("myCanvas_2");
      var cxt_2 = ccc_2.getContext("2d");
      var ccc_3 = document.getElementById("myCanvas_3");
      var cxt_3 = ccc_3.getContext("2d");
      var ccc_4 = document.getElementById("myCanvas_4");
      var cxt_4 = ccc_4.getContext("2d");
      var ccc_5 = document.getElementById("myCanvas_5");
      var cxt_5 = ccc_5.getContext("2d");
      // cxt.fillStyle = "#aaa";
      // cxt.fillRect(0,0,20,20);

      function rect_click(select_unitArr) {
        var width = 20;
        var height = 20;
        var ctxBox = cxt;
        var restart_num;
        for (var i = 0; i < 4097; i++) {
          var y = i * height + i * 1;
          for (var k = 1; k < 17; k++) {
            var x = k * width + k * 5;
            var num = i * 17 + k - (i + 1);
            if (select_unitArr) {
              if (num >= select_unitArr[0] && num <= select_unitArr[1]) {
                cxt.fillStyle = "#666";
                cxt.fillRect(x, y, width, height);
                cxt_2.fillStyle = "#666";
                cxt_2.fillRect(x, y - 21000, width, height);
                cxt_3.fillStyle = "#666";
                cxt_3.fillRect(x, y - 42000, width, height);
                cxt_4.fillStyle = "#666";
                cxt_4.fillRect(x, y - 63000, width, height);
                cxt_5.fillStyle = "#666";
                cxt_5.fillRect(x, y - 84000, width, height);
              }
            }
          }
        }
      }

      function func_select(select_unitArr) {
        fun_rect([3, 13, 29], [11, 25, 40]);
        rect_click(select_unitArr);
      }

      function unit_4(str) {
        while (str.length < 4) {
          str = "0" + str;
        }
        return str;
      }
      function _drawing(
        canvas_,
        start_num,
        end_num,
        from_num,
        last_num,
        base_num
      ) {
        var width = 20;
        var height = 20;
        for (var i = start_num; i <= end_num; i++) {
          var y = i * height + i * 1;
          for (var k = 0; k < 17; k++) {
            var x = k * width + k * 5;
            canvas_.fillStyle = "#ddd";
            canvas_.fillRect(x, y, width, height);

            //初始变色
            var num = (i + base_num) * 17 + k - (i + base_num + 1);
            var num_ = (i + base_num) * 17 + k;
            if (from_num) {
              var kkk = 0;
              while (kkk < from_num.length) {
                if (
                  num >= from_num[kkk] &&
                  num <= last_num[kkk] &&
                  num != kkk * 17 - (i + base_num + 1)
                ) {
                  canvas_.fillStyle = "#adadad";
                  canvas_.fillRect(x, y, width, height);
                }
                kkk++;
              }
            }
            //序列号
            if (num_ % 17 == 0) {
              canvas_.clearRect(x, y, width, height);
              canvas_.fillStyle = "#000";
              canvas_.font = "9px Arial";
              var index_text = i + base_num + 15 * (i + base_num) - 16;
              index_text = parseInt(index_text).toString(16);
              canvas_.fillText(unit_4(index_text).toLowerCase(), x, y - 1);
            }
          }
        }
      }
      function fun_rect(from_num, last_num) {
        _drawing(cxt, 0, 1000, from_num, last_num, 0);
        _drawing(cxt_2, 0, 1000, from_num, last_num, 1000);
        _drawing(cxt_3, 0, 1000, from_num, last_num, 2000);
        _drawing(cxt_4, 0, 1000, from_num, last_num, 3000);
        _drawing(cxt_5, 0, 96, from_num, last_num, 4000);
      }

      fun_rect([3, 13, 29], [11, 25, 99]);
    </script>
